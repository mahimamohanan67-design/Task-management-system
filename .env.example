DATABASE_URL=jdbc:postgresql://localhost:5434/morrow_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me
# Generate with: openssl rand -base64 48 (decoded value must be at least 32 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
